# Modelo sem credenciais. Copie para .env apenas no computador.
# No Render, preencha os valores nas variáveis de ambiente do serviço.
NODE_ENV=development

# Neon: tráfego da aplicação com Connection pooling ativado.
DATABASE_URL=

# Neon: mesmo banco e branch, com Connection pooling desativado.
DIRECT_DATABASE_URL=

# Login exclusivo do proprietário. Use senha com no mínimo 12 caracteres.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Opcional. No Render, RENDER_EXTERNAL_URL informa a URL padrão.
# Para domínio próprio, use a origem completa, sem caminho adicional.
APP_URL=

# Opcional em desenvolvimento. O Render fornece PORT automaticamente.
PORT=3000
