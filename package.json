{
  "name": "yuri-araujo-boutique-render-neon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Loja de sapatos e joias para Render, com administração e PostgreSQL Neon.",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env server/start.mjs",
    "dev": "node --env-file-if-exists=.env --watch server/start.mjs",
    "test": "node --test tests/*.test.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/db-migrate.mjs",
    "db:check": "node --env-file-if-exists=.env scripts/db-check.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.0.2",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "esbuild": "0.25.12",
    "happy-dom": "20.0.10"
  }
}
